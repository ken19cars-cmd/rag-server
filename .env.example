# 複製成 .env 後再填。不要把 .env 提交進版控。
# 預設不呼叫任何雲端模型。提問與舊版欄位分析一律抽取式。

# 索引目錄（SQLite）
RAG_DATA_DIR=./data

# 嵌入後端：local（預設，離線字元 n-gram，不下載模型）
# 或 sentence-transformers（需另裝 embeddings extra，第一次會下載模型）
RAG_EMBEDDING_BACKEND=local
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 切塊
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# 進行中案件的本機資料夾。四層：類型 / 縣市 / 案名 / PDF 或 txt。
# 伺服器必須跑在看得到這顆磁碟的機器上。路徑含括號或反斜線時請加引號。
# PowerShell:
#   $env:RAG_CASES_ROOT = 'D:\HS公司資料\HS網站(新視野)\網站資料\最新消息\招商案件'
# cmd:
#   set RAG_CASES_ROOT=D:\HS公司資料\HS網站(新視野)\網站資料\最新消息\招商案件
RAG_CASES_ROOT=

# 招標完成案件的離線清單（JSON 或 CSV）。沒有這份檔案、也沒有 Notion 金鑰時，
# GET /api/completed 會拒絕，不會自己上網搜尋。
# RAG_COMPLETED_CASES_FILE=./completed-cases.json

# 選用：與網站相同的 Notion 整合。只在沒有離線清單時，用來讀「招商情形=招標完成」。
# 不會把分析結果寫回 Notion。
RAG_NOTION_TOKEN=
RAG_NOTION_DATABASE_ID=

# 選用：電腦 B 上的 Ollama（OpenAI 相容）。base URL 與 model 都有值時，
# 只用於 POST /api/notion/analyze。金鑰可留空，會當成 ollama。
# 客戶端會在這個 URL 後面接 /chat/completions，所以填到 /v1 即可。
# 電腦 A 跑這個服務並持有 RAG_CASES_ROOT。不要把服務改放到 B、檔案留在 A（檔案共用以後再說）。
# Ollama 只讓 Tailscale 同伴連得到：不要對公網開放，也不要只綁 127.0.0.1。
# 模型寫出 PDF 沒有的句子會被丟掉；整份都站不住時改回抽取式。
# RAG_LLM_BASE_URL=http://<B-Tailscale-IP>:11434/v1
# RAG_LLM_API_KEY=
# RAG_LLM_MODEL=<model>
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=

# 爬蟲：公開網頁、自報身份、請求間隔。不要拿來登入或繞過驗證。
RAG_CRAWL_USER_AGENT=InvestmentCaseRAG/0.1 (public research client; investment-case analysis)
RAG_CRAWL_DELAY_SECONDS=1.0
RAG_CRAWL_TIMEOUT_SECONDS=20
RAG_CRAWL_MAX_PDF_BYTES=20000000

# 本機服務
RAG_HOST=127.0.0.1
RAG_PORT=8000
